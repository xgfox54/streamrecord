{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "stream-record",
  "version": "0.6.15",
  "identifier": "local.meetily.korean.workspace",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3118",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "stream-record · 실시간 회의록",
        "width": 1440,
        "height": 960,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "decorations": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost",
        "frame-src": "'self' https://www.youtube.com https://www.youtube-nocookie.com",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main",
          "description": "Main window: core window, event and path access only",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:path:default",
            "core:event:default",
            "core:window:default",
            "core:app:default",
            "core:resources:default",
            "core:menu:default",
            "core:tray:default",
            "core:window:allow-set-title",
            "core:window:allow-hide"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png",
      "icons/app_icon.icns",
      "icons/app_icon.ico"
    ],
    "resources": [
      "templates/*.json"
    ],
    "externalBin": [
      "binaries/llama-helper",
      "binaries/ffmpeg"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/app_icon.ico",
        "uninstallerIcon": "icons/app_icon.ico"
      },
      "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
    }
  },
  "plugins": {},
  "mainBinaryName": "stream-record"
}
